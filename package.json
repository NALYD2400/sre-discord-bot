{
  "name": "sre-discord-bot",
  "version": "1.0.0",
  "description": "Bot Discord officiel SR Editer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js dist/commands/*.test.js",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "watch": "tsc --watch",
    "render:build": "npm install && npm run build",
    "render:start": "node --dns-result-order=ipv4first dist/index.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
